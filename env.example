
NODE_ENV = production
DEVELOPMENT_ADDRESS = 192.168.0.12
TEST_ADDRESS = 192.168.0.12
PRODUCTION_ADDRESS = waridi.co
PRODUCTION_IMAGE_URL=https://api.waridi.org/images/
DEVELOPMENT_IMAGE_URL=http://localhost:8084/images/
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACTIVATION_TOKEN_SECRET=
MAILING_SERVICE_REFRESH_TOKEN=
SENDER_EMAIL_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_ID=
FACEBOOK_SECRET=
JWT_TOKEN=
JWT_REFRESH_TOKEN=
PLACES_API_ENDPOINT = https://maps.googleapis.com/maps/api/place/findplacefromtext/json
PLACES_SEARCH_API_ENDPOINT = https://maps.googleapis.com/maps/api/place/nearbysearch/json
API_KEY =
TEXTFLOW_API_KEY=
REDIS_SESSION_SECRET =
TEXT_SMS_API_KEY =
DATABASE_PASSWORD =
DATABASE_HOST =
DATABASE_PORT =
DATABASE_USER =
DATABASE_NAME =
MONGO_URI =
REDIS_URL =
SECRET =
FIREBASE_SERVICE_ACCOUNT_PATH =

# Required. The server refuses to start without them (src/config/checkEnv.js).
# In production REDIS_SESSION_SECRET and DATABASE_PASSWORD are required too.
# Generate secrets with: openssl rand -hex 32
# JWT_TOKEN, JWT_REFRESH_TOKEN and REDIS_SESSION_SECRET are listed above.

PORT=8084
GRPC_PORT=50051
# Number of reverse proxies in front of the app (1 behind nginx), so the
# login rate limits see the real client IP. Leave 0 when clients connect directly.
TRUST_PROXY=0
# Requests per client IP per 15 minutes on signin, signup, verify,
# verify-agent-login, forgotpassword and resetpassword.
AUTH_RATE_LIMIT_MAX=20
# Largest JSON or form body accepted. File uploads are not limited by this.
BODY_LIMIT=10mb

# RabbitMQ: signup, agent login and forgot-password publish email jobs to
# EMAIL_QUEUE. A separate consumer service sends them (see README → Email delivery).
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
EMAIL_QUEUE=email_queue
DEAD_LETTER_QUEUE=email_dead_letter

<!-- templates/layouts/password-reset-otp.ejs -->
<h2>Reset Your Password</h2>

<p>Hello <strong><%= name || 'User' %></strong>,</p>

<p>
  We received a request to reset the password for your <strong>Waridi</strong> account. Use the code below to choose a new password.
</p>

<div style="text-align: center; margin: 30px 0;">
  <span style="display: inline-block; font-size: 34px; font-weight: 700; color: #1a202c; background: #f7fafc; padding: 16px 40px; border-radius: 12px; letter-spacing: 8px; border: 2px dashed #3182ce; font-family: 'Courier New', monospace;">
    <%= otp %>
  </span>
</div>

<p>This code is valid for <strong><%= expiryMinutes || 10 %> minutes</strong>.</p>

<p style="margin-top: 8px;">
  If you did not ask to reset your password, you can ignore this email. Your password will not change.
</p>

<p style="margin-top: 28px;">
  Best regards,<br>
  <strong>The Waridi Team</strong>
</p>

<!-- templates/otp.ejs -->
<h2>Your OTP Code</h2>
<p>Hello, <strong><%= name || 'User' %></strong>!</p>
<p>You requested a one‑time password (OTP) to verify your identity. Please use the code below:</p>

<div style="text-align: center; margin: 30px 0;">
  <span style="display: inline-block; font-size: 32px; font-weight: bold; color: #1a202c; background: #f7fafc; padding: 16px 32px; border-radius: 12px; letter-spacing: 4px; border: 2px dashed #3182ce;">
    <%= otp %>
  </span>
</div>

<p>This code expires in <strong><%= expiryMinutes || 5 %> minutes</strong>.</p>
<p>If you didn't request this code, please ignore this email.</p>

<p style="margin-top: 24px;">
  Best regards,<br>
  <strong>The Waridi Team</strong>
</p>
